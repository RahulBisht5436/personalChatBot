OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# LangSmith (optional — for LangGraph Studio tracing during local dev)
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=personal-chatbot

# Visitor verification
FREE_CHAT_LIMIT=5
OTP_EXPIRY_MINUTES=10
LEAD_NOTIFICATION_EMAIL=your-notification-email@example.com

# SMTP (required for OTP + lead notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Optional: custom RAG folder (default: RAGDatabase/ inside this repo)
# RAG_DATABASE_PATH=C:/path/to/RAGDatabase

# Optional production API URL for download links
API_BASE_URL=http://127.0.0.1:8000
