OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Visitor verification
FREE_CHAT_LIMIT=5
OTP_EXPIRY_MINUTES=10
LEAD_NOTIFICATION_EMAIL=your-notification-email@example.com

# SMTP (required for OTP + lead notification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Optional: custom RAG folder (default: RAGDatabase/ inside this repo)
# RAG_DATABASE_PATH=C:/path/to/RAGDatabase

# Optional production API URL for download links
API_BASE_URL=http://127.0.0.1:8000

# Public portfolio contact (shown when visitors ask how to reach Rahul)
PORTFOLIO_CONTACT_EMAIL=your-public-email@example.com
PORTFOLIO_CONTACT_PHONE=your-phone-number
# PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
# PORTFOLIO_GITHUB_URL=https://github.com/your-username

# NeMo Guardrails: use "default" (built-in OpenAI client). Only set to "langchain"
# if you also install the langchain package (not just langchain-openai).
NEMOGUARDRAILS_LLM_FRAMEWORK=default
